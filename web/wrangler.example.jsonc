{
  // Copy this file to `wrangler.jsonc` and fill in your own custom domain (or
  // remove `routes` to use the workers.dev subdomain) before deploying. The
  // real `wrangler.jsonc` is gitignored so deploy-specific ids/domains stay
  // out of the public repo. See README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autoslides-web",
  "main": "src/index.ts",
  // Local `wrangler dev` rejects a future compatibility_date. Keep this at or
  // before today's date. Bump as needed when deploying.
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static frontend (Vite build output — run `npm run build` first). Files
  // here serve directly; any path that is NOT an asset falls through to the
  // Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA fallback: unknown paths (vue-router history-mode deep links like
    // /player/...) serve index.html instead of 404. Applies to the Worker's
    // ASSETS.fetch() catch-all too.
    "not_found_handling": "single-page-application"
  },

  // Custom domain — Cloudflare creates/manages the DNS record and attaches this
  // Worker to the whole hostname. Adjust to your own zone, or remove to fall
  // back to the workers.dev subdomain.
  "routes": [
    { "pattern": "example.com", "custom_domain": true }
  ],

  // Key the Worker seals the mid-login state of an SMS second factor with. Not a
  // campus or Cloudflare credential — just a random string this Worker encrypts
  // to itself with, so the browser can carry a half-finished CAS login between
  // POST /api/login and POST /api/login/sms without reading or forging it.
  //
  // Generate your own before deploying (`openssl rand -base64 32`). It lives in
  // the real, gitignored wrangler.jsonc so deploys carry it automatically.
  //
  // Leaving it out is supported: password login still works, but an account that
  // requires an SMS code answers `sms_unavailable` and falls back to the
  // token-paste flow. See README.md.
  "vars": {
    "SSO_RESUME_KEY": "replace-me-with-a-long-random-string",
    // Optional. Origin this Worker fetches for `/api/ai/*` (the browser stays
    // on this host). Unset → those routes 503. The Worker sends User-Agent
    // `AutoSlides/web` on that fetch.
    // "AI_ORIGIN": "https://ai.example.com"

    // Optional. Recorded-video relay policy (see src/lib/relayPolicy.ts).
    //
    // With RELAY_PUBLIC_ORIGIN set, the SPA streams recorded lectures straight
    // from that origin, so each viewer meets the relay's own protection (a
    // campus-network allowlist, in our deployment), and this Worker's
    // /playlist + /segment answer 403.
    //
    // ALLOW_OFFCAMPUS_RELAY: "true" relays everyone through the RELAY binding
    // on this Worker instead — a Worker-to-Worker hop, so the relay's edge
    // never sees the viewer. Off by default.
    //
    // Neither set (the plain clone): the binding is used, exactly as before —
    // there is no public origin to send a browser to, so there is no gate.
    // "RELAY_PUBLIC_ORIGIN": "https://relay.example.com",
    // "ALLOW_OFFCAMPUS_RELAY": "true"
  },

  // Optional same-account service bindings. Uncomment if you deploy ../relay
  // (recorded HLS) and/or ../share (short-link KV). Unbound,
  // GET /playlist|/segment and GET /api/share/* return 503.
  // "services": [
  //   { "binding": "RELAY", "service": "yanhekt-proxy", "remote": true },
  //   { "binding": "SHARE", "service": "autoslides-share", "remote": true }
  // ],

  "observability": {
    "enabled": false
  }
}
