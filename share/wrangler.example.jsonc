{
  // Copy this file to `wrangler.jsonc` and fill in your own KV namespace id and
  // custom domain before deploying. The real `wrangler.jsonc` is gitignored so
  // deploy-specific ids stay out of the public repo. See README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autoslides-share",
  "main": "src/worker.ts",
  "compatibility_date": "2025-06-01",

  // Static viewer (Vite build output: dist/v1 app + root favicons). The Worker
  // handles the v1 KV shorten/resolve API, the short-link route and /api.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // KV for v1 short links.
  // Create with:  wrangler kv namespace create SHARE_KV
  "kv_namespaces": [
    { "binding": "SHARE_KV", "id": "<YOUR_KV_NAMESPACE_ID>" }
  ],

  // D1 `yanhekt-index`, filled by indexer/ (see indexer/README.md). The Worker
  // only reads it. Create with:  wrangler d1 create yanhekt-index --location apac
  "d1_databases": [
    { "binding": "YANHEKT_DB", "database_name": "yanhekt-index", "database_id": "<YOUR_D1_DATABASE_ID>" }
  ],


  // Region placement (dashboard: Region → AWS → ap-east-1): the isolate runs
  // in the Cloudflare data center closest to AWS Hong Kong.
  "placement": {
    "region": "aws:ap-east-1"
  },

  // Custom domain — Cloudflare creates/manages the DNS record and attaches this
  // Worker to the whole hostname. Adjust to your own zone.
  "routes": [
    { "pattern": "example.com", "custom_domain": true }
  ]
}
