{
  "name": "autoslides-share",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AutoSlides share viewer (v1) + Index API over the yanhekt-index D1 database — Cloudflare Worker.",
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && vite build && node -e \"require('node:fs').cpSync('public', 'dist', { recursive: true })\" && npm run build:demo",
    "build:demo": "vite build -c vite.demo-v1.config.ts",
    "demo": "vite -c vite.demo-v1.config.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.61.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
