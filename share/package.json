{
  "name": "autoslides-share",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AutoSlides share viewer (v1) + AutoSlides Index (v2) — Cloudflare Worker, KV short links, D1 metadata.",
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && vite build && vite build -c vite.apex.config.ts && npm run build:demo",
    "build:demo": "vite build -c vite.demo.config.ts && vite build -c vite.demo-v1.config.ts",
    "demo": "vite -c vite.demo.config.ts",
    "demo:v1": "vite -c vite.demo-v1.config.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply autoslides-index-v2",
    "db:migrate:local": "wrangler d1 migrations apply autoslides-index-v2 --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.61.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
