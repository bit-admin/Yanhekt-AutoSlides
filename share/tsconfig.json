{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "apex",
    "vite.apex.config.ts",
    "../autoslides/src/shared/shareLink.ts",
    "../autoslides/src/shared/shareTimeline.ts",
    "../autoslides/src/shared/notesContent.ts",
    "../autoslides/src/shared/notesTypes.ts",
    "../autoslides/src/shared/lectureNaming.ts",
    "../autoslides/src/shared/slideMetadataTypes.ts",
    "../autoslides/src/shared/academicTerm.ts"
    // sidecars/timeline is imported by shareTimeline.ts / notesContent.ts.
    // Do not glob that folder: **/*.ts would pull in timeline.test.ts, and
    // exclude patterns here are rooted at share/ so they cannot match ../autoslides.
  ]
}
