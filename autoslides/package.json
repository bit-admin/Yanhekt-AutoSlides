{
  "name": "autoslides",
  "productName": "AutoSlides",
  "version": "5.2.1",
  "description": "Watch Yanhekt live and recorded lectures and extract their slides automatically.",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "demo": "DEMO_MODE=1 electron-forge start",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:web": "node scripts/screenshots.mjs --no-native",
    "screenshots:build": "npm run package && node scripts/screenshots.mjs",
    "docs:images": "node scripts/process-docs.mjs",
    "package": "electron-forge package",
    "make:mac": "npm run index-bundle && electron-forge package && rm out/AutoSlides-darwin-arm64/LICENSE out/AutoSlides-darwin-arm64/LICENSES.chromium.html out/AutoSlides-darwin-arm64/version && rm -rf \"out/AutoSlides-$npm_package_version-macOS-arm64\" && mv out/AutoSlides-darwin-arm64 \"out/AutoSlides-$npm_package_version-macOS-arm64\" && dropdmg --config-name 'AutoSlides' \"out/AutoSlides-$npm_package_version-macOS-arm64\" && node scripts/update-signing.mjs sign \"out/AutoSlides-$npm_package_version-macOS-arm64.dmg\"",
    "index-bundle": "node --disable-warning=ExperimentalWarning ../indexer/src/cli.ts release bundle --out vendor/course-index --keys src/main/platform/courseIndex/indexSigningKeys.json",
    "make:win": "electron-forge package --platform=win32 --arch=x64 && electron-builder --win --config electron-builder.yml --prepackaged out/AutoSlides-win32-x64 --publish never",
    "make:linux": "electron-forge package --platform=linux --arch=x64 && electron-builder --linux --config electron-builder.yml --prepackaged out/AutoSlides-linux-x64 --publish never",
    "publish": "electron-forge publish",
    "sign:update": "node scripts/update-signing.mjs sign",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:config-schema": "node scripts/gen-config-schema.mjs"
  },
  "keywords": [],
  "author": {
    "name": "BIT-admin",
    "email": "info@ruc.edu.kg"
  },
  "homepage": "https://github.com/bit-admin/Yanhekt-AutoSlides",
  "license": "Apache-2.0",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.1",
    "@types/crypto-js": "^4.2.2",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "braces": "file:vendor/braces",
    "electron": "^42.11.18",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "extract-zip": "file:vendor/extract-zip",
    "playwright": "^1.61.0",
    "terser": "^5.44.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.3.7",
    "vite-plugin-static-copy": "^4.1.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.2.6"
  },
  "overrides": {
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "extract-zip": "$extract-zip",
    "braces": "$braces",
    "image-size": "^2.0.4"
  },
  "dependencies": {
    "@editorjs/code": "^2.8.0",
    "@editorjs/delimiter": "^1.3.0",
    "@editorjs/editorjs": "^2.26.5",
    "@editorjs/header": "^2.7.0",
    "@editorjs/image": "^2.8.2",
    "@editorjs/list": "^1.8.0",
    "@editorjs/quote": "^2.5.0",
    "@editorjs/table": "^2.4.6",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@types/pdfkit": "^0.17.4",
    "ajv": "^8.20.0",
    "axios": "^1.20.0",
    "bottleneck": "^2.19.5",
    "crypto-js": "^4.2.0",
    "docx": "^9.7.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.10",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.1",
    "jszip": "^3.10.1",
    "onnxruntime-web": "^1.27.0",
    "pdfkit": "^0.18.0",
    "pinyin-pro": "^3.29.3",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8"
  }
}
