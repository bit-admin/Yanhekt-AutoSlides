  "definitions": {
    "ConnectionMode": {
      "type": "string",
      "enum": [
        "auto",
        "internal",
        "external"
      ],
      "description": "`auto` uses the campus intranet while it can be reached and the public network otherwise; the other two force one route."
    },
    "MuteMode": {
      "type": "string",
      "enum": [
        "normal",
        "mute_all",
        "mute_live",
        "mute_recorded"
      ]
    },
    "Yanhe2CaptionMode": {
      "type": "string",
      "enum": [
        "auto",
        "offset"
      ]
    },
    "ThemeMode": {
      "type": "string",
      "enum": [
        "system",
        "light",
        "dark"
      ]
    },
    "LanguageMode": {
      "type": "string",
      "enum": [
        "system",
        "en",
        "zh",
        "ja",
        "ko"
      ]
    },
    "SlideExtractionConfig": {
      "type": "object",
