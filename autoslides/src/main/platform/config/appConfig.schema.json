          "type": "number"
        },
        "imageResizeHeight": {
          "type": "number"
        },
        "maxConcurrent": {
          "type": "number"
        },
        "minTime": {
          "type": "number"
        },
        "requestBody": {
          "$ref": "#/definitions/AIRequestBodySettings",
          "description": "Optional chat-completion body parameters (omit when null)."
        },
        "mlThresholds": {
          "$ref": "#/definitions/MlClassifierThresholds"
        },
        "mlClassifierActiveModel": {
          "type": "string",
          "enum": [
            "builtin",
            "custom"
          ]
        },
        "mlClassifierCustomModelName": {
          "type": [
            "string",
            "null"
          ]
        }
