      "type": "object",
      "properties": {
        "binaryPath": {
          "type": "string"
        },
        "autoRunAfterDownload": {
          "type": "boolean"
        },
        "autoPostProcessAfter": {
          "type": "boolean"
        }
      }
    },
    "PinnedCourse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "description": "Chinese course name — canonical, feeds filenames once the pin is opened."
        },
        "titleEn": {
          "type": "string",
          "description": "English course name, when the API had one. Display only; absent on legacy pins."
        },
        "number": {
          "type": "string",
          "description": "Registrar course number (Yanhe 2.0 `kcwybm`); absent on older pins until reopened."
        },
        "instructor": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "classrooms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            }
          }
        },
        "participant_count": {
          "type": "number"
        },
        "college_name": {
          "type": "string"
        },
        "professors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "school_year": {
          "type": "string"
        },
        "semester": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string",
          "description": "Cover URL from Yanhekt list/detail; optional on legacy pins."
        }
      }
    },
    "WatchNotesProviderId": {
      "type": "string",
      "enum": [
        "yanhekt",
        "obsidian",
        "notion"
      ]
