# Copy to .env (git-ignored). Only needed for `upload`, `status --remote` and `--upload`.
#
# Account id: Cloudflare dashboard → Workers & Pages → right-hand sidebar ("Account ID").
# Database id: `npx wrangler d1 create yanhekt-index` prints it, or dashboard → D1 → the database.
# Token: dashboard → My Profile → API Tokens → Create Token → Custom token
#        with permission  Account · D1 · Edit  (nothing else is needed).
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=
