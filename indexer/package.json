{
  "name": "yanhekt-indexer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local, no-auth Yanhekt session indexer. Walks session ids at a gentle rate inside a nightly window and stores everything in SQLite.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts run",
    "now": "node --disable-warning=ExperimentalWarning src/cli.ts now",
    "status": "node --disable-warning=ExperimentalWarning src/cli.ts status",
    "dump": "node --disable-warning=ExperimentalWarning src/cli.ts dump",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3"
  }
}
