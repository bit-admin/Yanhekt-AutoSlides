{
  // Copy this file to `wrangler.jsonc` and set your own custom domain before
  // deploying. The real `wrangler.jsonc` is gitignored so deploy-specific
  // config stays out of the public repo. See README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yanhekt-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    // Note: query strings (which carry the login token) may appear in logs.
    // Disable or scrub if that matters for your deployment.
    "enabled": false
  },

  // Region placement. Change `region`, or delete this block to run the Worker
  // in the edge city the viewer reached. Then `npm run dev` or `npm run deploy`.
  // The recording origin is cvideo.yanhekt.cn (183.243.192.45) in Beijing, so
  // the closest pin is aws:ap-east-1 (Hong Kong). Asia tests:
  // aws:ap-northeast-2 (Seoul), aws:ap-northeast-1 (Tokyo),
  // aws:ap-northeast-3 (Osaka), aws:ap-southeast-1 (Singapore).
  // See src/placementRegions.ts.
  "placement": {
    "region": "aws:ap-east-1"
  },

  // Custom domain — Cloudflare creates/manages the DNS record and attaches this
  // Worker to the whole hostname. Adjust to your own zone.
  "routes": [
    { "pattern": "example.com", "custom_domain": true }
  ]
}
